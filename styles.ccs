<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Lenawei Safaris - Your Complete Travel & Tourism Partner. Book flights, trains, ships, safaris, hotels, and airport transfers.">
    <meta name="keywords" content="Safari, Travel, Tourism, Kenya, Flights, Hotels, Tours, Adventure">
    <meta name="author" content="Lenawei Safaris">
    <title>Lenawei Safaris - Explore • Learn • Experience</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="icon" type="image/svg+xml" href="images/logo.svg">
</head>
<body>
    <header>
        <div class="header-container">
            <div class="logo-section">
                <img src="images/logo.svg" alt="Lenawei Safaris Logo" class="logo-img">
                <div class="company-info">
                    <h1 class="company-name">Lenawei Safaris</h1>
                    <p class="company-tagline">Explore • Learn • Experience</p>
                </div>
            </div>

            <button class="mobile-menu-toggle" id="mobileMenuToggle">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav class="navbar" id="navbar">
                <button class="tab-button" data-section="home">Home</button>
                <button class="tab-button" data-section="services">Services</button>
                <button class="tab-button" data-section="itineraries">Safari Packages</button>
                <button class="tab-button" data-section="transportation">Transportation</button>
                <button class="tab-button" data-section="accommodations">Accommodations</button>
                <button class="tab-button" data-section="testimonials">Testimonials</button>
                <button class="tab-button" data-section="safari-map">Safari Map</button>
                <button class="tab-button" data-section="team">Our Team</button>
                <button class="tab-button" data-section="faqs">FAQs</button>
                <button class="tab-button" data-section="contact">Contact</button>
            </nav>
        </div>
    </header>

    <main>
        <!-- Home/Hero Section -->
        <section id="home" class="content-section hero-section">
            <div class="hero-content">
                <h2>Welcome to Lenawei Safaris</h2>
                <p class="hero-subtitle">Your Complete Travel & Tourism Solution</p>
                <p class="hero-description">Experience unforgettable adventures across East Africa with Kenya's most trusted travel company. From wildlife safaris to seamless travel arrangements, we handle every detail of your journey.</p>
                
                <div class="hero-buttons">
                    <button class="cta-button primary-btn" onclick="document.querySelector('[data-section=\"itineraries\"]').click()">Book a Safari</button>
                    <button class="cta-button secondary-btn" onclick="document.querySelector('[data-section=\"contact\"]').click()">Contact Us</button>
                </div>

                <div class="hero-features">
                    <div class="feature-box">
                        <span class="feature-icon">✈️</span>
                        <h3>Flights & Travel</h3>
                        <p>International & domestic flights</p>
                    </div>
                    <div class="feature-box">
                        <span class="feature-icon">🦁</span>
                        <h3>Safari Tours</h3>
                        <p>Incredible wildlife experiences</p>
                    </div>
                    <div class="feature-box">
                        <span class="feature-icon">🏨</span>
                        <h3>Accommodations</h3>
                        <p>Luxury to budget-friendly stays</p>
                    </div>
                    <div class="feature-box">
                        <span class="feature-icon">🚗</span>
                        <h3>Ground Transport</h3>
                        <p>Safe & comfortable transfers</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Our Services Section -->
        <section id="services" class="content-section services-section">
            <div class="section-header">
                <h2>🎯 Our Comprehensive Services</h2>
                <p class="section-subtitle">At Lenawei Safaris, we are your one-stop travel and tourism solution, offering exceptional services across all travel needs:</p>
            </div>
            
            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">✈️</div>
                    <h3>Flight Bookings</h3>
                    <p>Competitive flight arrangements to domestic and international destinations. We partner with major airlines to offer you the best rates and flexible booking options for your journey.</p>
                    <ul>
                        <li>Domestic & International Flights</li>
                        <li>Charter Services Available</li>
                        <li>Travel Insurance Included</li>
                        <li>24/7 Booking Support</li>
                    </ul>
                </div>

                <div class="service-card">
                    <div class="service-icon">🚂</div>
                    <h3>Rail Services</h3>
                    <p>Experience Kenya's most scenic railway journeys. From the famous Lunatic Express to modern express trains, we arrange comfortable rail travel with premium seating options.</p>
                    <ul>
                        <li>Standard & Luxury Train Packages</li>
                        <li>Historical Scenic Routes</li>
                        <li>Meal & Beverage Services</li>
                        <li>Guided Commentary Included</li>
                    </ul>
                </div>

                <div class="service-card">
                    <div class="service-icon">🚢</div>
                    <h3>Cruise & Ship Services</h3>
                    <p>Explore East Africa's coastal beauty with our cruise and ship packages. Perfect for beach getaways, island hopping, and luxury maritime experiences.</p>
                    <ul>
                        <li>Coastal Cruise Packages</li>
                        <li>Island Hopping Tours</li>
                        <li>Luxury Ship Accommodations</li>
                        <li>Water Sports Activities</li>
                    </ul>
                </div>

                <div class="service-card">
                    <div class="service-icon">🚍</div>
                    <h3>Ground Transportation & Chopas</h3>
                    <p>Professional vehicle rental and chauffeured services. Our fleet includes comfortable 4x4s, minibuses, and coaches for safari tours and general transportation needs.</p>
                    <ul>
                        <li>4x4 Safari Vehicles</li>
                        <li>Minibus & Coach Rentals</li>
                        <li>Airport Transfers</li>
                        <li>Professional Drivers & Guides</li>
                    </ul>
                </div>

                <div class="service-card">
                    <div class="service-icon">🏨</div>
                    <h3>Hotel & Accommodation Booking</h3>
                    <p>Access to over 500+ verified hotels, lodges, and resorts across Kenya. From luxury 5-star properties to budget-friendly options, we find the perfect accommodation for your needs.</p>
                    <ul>
                        <li>Budget to Luxury Properties</li>
                        <li>Safari Lodges & Tented Camps</li>
                        <li>Beach Resorts & Urban Hotels</li>
                        <li>Best Rate Guarantee</li>
                    </ul>
                </div>

                <div class="service-card">
                    <div class="service-icon">🦁</div>
                    <h3>Wildlife Tours & Safari Packages</h3>
                    <p>Expertly curated wildlife safaris in Kenya's most iconic parks. Experience the Big Five and Africa's incredible biodiversity with our experienced naturalist guides.</p>
                    <ul>
                        <li>Masai Mara Wildlife Safari</li>
                        <li>Amboseli & Tsavo Parks</li>
                        <li>Lake Nakuru & Great Rift Valley</li>
                        <li>Customized Safari Itineraries</li>
                    </ul>
                </div>

                <div class="service-card">
                    <div class="service-icon">🗺️</div>
                    <h3>Travel Planning & Agency Services</h3>
                    <p>Full-service travel agent support for complete trip coordination. From visa assistance to itinerary planning, we handle every detail of your journey.</p>
                    <ul>
                        <li>Complete Trip Coordination</li>
                        <li>Visa & Documentation Support</li>
                        <li>Travel Insurance Services</li>
                        <li>Emergency Travel Assistance</li>
                    </ul>
                </div>

                <div class="service-card">
                    <div class="service-icon">🛫</div>
                    <h3>Airport & Ground Transfers</h3>
                    <p>Seamless airport transfers with professional drivers. Meet-and-greet services, luggage handling, and comfortable vehicles for stress-free arrivals and departures.</p>
                    <ul>
                        <li>Meet & Greet Services</li>
                        <li>Luggage Assistance</li>
                        <li>Scheduled & On-Demand Transfers</li>
                        <li>All Major Airports Covered</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Safari Packages Section -->
        <section id="itineraries" class="content-section itineraries-section">
            <div class="section-header">
                <h2>🎒 Safari Packages & Itineraries</h2>
                <p class="section-subtitle">Choose from our expertly designed safari packages or let us customize one for your group:</p>
            </div>
            
            <div class="itinerary-cards">
                <div class="itinerary-card">
                    <div class="itinerary-badge">Budget Friendly</div>
                    <h3>🌟 3-Day Classic Safari</h3>
                    <p class="itinerary-duration"><strong>Duration:</strong> 3 Days / 2 Nights</p>
                    <p class="itinerary-route"><strong>Route:</strong> Nairobi → Amboseli National Park → Tsavo East → Nairobi</p>
                    <p><strong>Highlights:</strong></p>
                    <ul>
                        <li>Mount Kilimanjaro Views</li>
                        <li>Elephant & Wildlife Viewing</li>
                        <li>Full Board Meals</li>
                        <li>Professional Naturalist Guide</li>
                        <li>Game Drives (Morning & Afternoon)</li>
                    </ul>
                    <div class="itinerary-footer">
                        <p class="itinerary-price">From KES 45,000</p>
                        <button class="book-btn" onclick="bookSafari('3-Day Classic Safari')">Book Now</button>
                    </div>
                </div>

                <div class="itinerary-card featured">
                    <div class="itinerary-badge popular">Most Popular</div>
                    <h3>⭐⭐ 5-Day Masai Mara Adventure</h3>
                    <p class="itinerary-duration"><strong>Duration:</strong> 5 Days / 4 Nights</p>
                    <p class="itinerary-route"><strong>Route:</strong> Nairobi → Masai Mara → Lake Nakuru → Nairobi</p>
                    <p><strong>Highlights:</strong></p>
                    <ul>
                        <li>Big Five Wildlife Viewing</li>
                        <li>Masai Mara Game Reserve</li>
                        <li>Lake Nakuru Flamingos</li>
                        <li>Maasai Village Cultural Visit</li>
                        <li>Photography Safaris Included</li>
                    </ul>
                    <div class="itinerary-footer">
                        <p class="itinerary-price">From KES 75,000</p>
                        <button class="book-btn" onclick="bookSafari('5-Day Masai Mara Adventure')">Book Now</button>
                    </div>
                </div>

                <div class="itinerary-card">
                    <div class="itinerary-badge">Premium</div>
                    <h3>⭐⭐⭐ 7-Day Ultimate Kenya Experience</h3>
                    <p class="itinerary-duration"><strong>Duration:</strong> 7 Days / 6 Nights</p>
                    <p class="itinerary-route"><strong>Route:</strong> Complete Kenyan Wildlife Circle</p>
                    <p><strong>Highlights:</strong></p>
                    <ul>
                        <li>All Major National Parks</li>
                        <li>Premium Luxury Accommodations</li>
                        <li>Private Vehicle & Guide</li>
                        <li>Cultural Experiences</li>
                        <li>Professional Photography Guidance</li>
                    </ul>
                    <div class="itinerary-footer">
                        <p class="itinerary-price">From KES 120,000</p>
                        <button class="book-btn" onclick="bookSafari('7-Day Ultimate Kenya Experience')">Book Now</button>
                    </div>
                </div>

                <div class="itinerary-card">
                    <div class="itinerary-badge">Luxury</div>
                    <h3>🏝️ 10-Day Safari & Beach Combo</h3>
                    <p class="itinerary-duration"><strong>Duration:</strong> 10 Days / 9 Nights</p>
                    <p class="itinerary-route"><strong>Route:</strong> Wildlife Safari + Coastal Paradise</p>
                    <p><strong>Highlights:</strong></p>
                    <ul>
                        <li>Safari Portion (5 Days)</li>
                        <li>Beach Resort (5 Days)</li>
                        <li>Water Sports Activities</li>
                        <li>Island Excursions</li>
                        <li>All-Inclusive Meals</li>
                    </ul>
                    <div class="itinerary-footer">
                        <p class="itinerary-price">From KES 150,000</p>
                        <button class="book-btn" onclick="bookSafari('10-Day Safari & Beach Combo')">Book Now</button>
                    </div>
                </div>
            </div>

            <div class="custom-itinerary">
                <h3>Don't See What You're Looking For?</h3>
                <p>We offer fully customized safari packages tailored to your preferences, budget, and interests. Contact us to create your perfect itinerary!</p>
                <button class="cta-button primary-btn" onclick="document.querySelector('[data-section=\"contact\"]').click()">Create Custom Itinerary</button>
            </div>
        </section>

        <!-- Transportation Section -->
        <section id="transportation" class="content-section">
            <div class="section-header">
                <h2>🚗 Transportation & Fleet Services</h2>
                <p class="section-subtitle">Our modern, well-maintained fleet ensures comfortable and safe journeys across Kenya:</p>
            </div>
            
            <div class="fleet-grid">
                <div class="fleet-card">
                    <div class="fleet-icon">🚙</div>
                    <h3>4x4 Safari Vehicles</h3>
                    <p>Purpose-built safari vehicles with pop-up roofs for optimal wildlife viewing. Comfortable seating for 4-6 passengers with experienced drivers.</p>
                    <ul>
                        <li>Roof Hatches for Photography</li>
                        <li>Air Conditioning & Heating</li>
                        <li>GPS Navigation & Communication</li>
                        <li>First Aid & Safety Equipment</li>
                        <li>Binoculars & Field Guides Provided</li>
                    </ul>
                </div>

                <div class="fleet-card">
                    <div class="fleet-icon">🚌</div>
                    <h3>Minibus & Chopa Services</h3>
                    <p>Comfortable minibuses for group tours and airport transfers. Seating for 12-14 passengers with professional drivers and excellent safety records.</p>
                    <ul>
                        <li>Comfortable Reclining Seats</li>
                        <li>Air Conditioning</li>
                        <li>Entertainment Systems</li>
                        <li>Radio & Communication Equipment</li>
                        <li>Experienced Drivers</li>
                    </ul>
                </div>

                <div class="fleet-card">
                    <div class="fleet-icon">🚍</div>
                    <h3>Full-Size Coach Services</h3>
                    <p>Large group transportation for 40+ passengers. Ideal for corporate events, school trips, and large tour groups with onboard amenities.</p>
                    <ul>
                        <li>Luxury Seating Arrangements</li>
                        <li>Onboard Toilet Facilities</li>
                        <li>Entertainment & WiFi</li>
                        <li>Professional Coaching Team</li>
                        <li>Group Meal Coordination</li>
                    </ul>
                </div>

                <div class="fleet-card">
                    <div class="fleet-icon">🚗</div>
                    <h3>Sedan & SUV Rentals</h3>
                    <p>Chauffeur-driven luxury vehicles for discerning travelers. Premium comfort for city tours, airport transfers, and executive travel.</p>
                    <ul>
                        <li>Premium Leather Interiors</li>
                        <li>Climate Control</li>
                        <li>Professional Drivers</li>
                        <li>Business Amenities</li>
                        <li>Complimentary WiFi & Refreshments</li>
                    </ul>
                </div>
            </div>

            <div class="transport-stats">
                <div class="stat-box">
                    <h4>500+</h4>
                    <p>Happy Customers Annually</p>
                </div>
                <div class="stat-box">
                    <h4>50+</h4>
                    <p>Vehicles in Fleet</p>
                </div>
                <div class="stat-box">
                    <h4>20+</h4>
                    <p>Years Experience</p>
                </div>
                <div class="stat-box">
                    <h4>100%</h4>
                    <p>Safety Record</p>
                </div>
            </div>
        </section>

        <!-- Accommodations Section -->
        <section id="accommodations" class="content-section">
            <div class="section-header">
                <h2>🏨 Hotel & Accommodation Partnerships</h2>
                <p class="section-subtitle">We partner with the finest hotels, lodges, and resorts across Kenya to ensure your perfect stay:</p>
            </div>
            
            <div class="accommodation-grid">
                <div class="accommodation-card">
                    <div class="stars">⭐⭐⭐⭐⭐</div>
                    <h3>Luxury 5-Star Properties</h3>
                    <p>Premium accommodations in Nairobi, Masai Mara, and coastal destinations. World-class amenities, gourmet dining, and spa services.</p>
                    <ul>
                        <li>Private Villas & Suites</li>
                        <li>Michelin-Quality Dining</li>
                        <li>Full-Service Spas</li>
                        <li>Concierge Services</li>
                        <li>Room Service 24/7</li>
                    </ul>
                </div>

                <div class="accommodation-card">
                    <div class="stars">⭐���⭐⭐</div>
                    <h3>Upscale Safari Lodges</h3>
                    <p>Comfortable safari lodges with stunning wildlife views. Perfect balance of luxury and authenticity for the ultimate safari experience.</p>
                    <ul>
                        <li>En-Suite Game Viewing</li>
                        <li>Fine Dining Restaurants</li>
                        <li>Wildlife Photography Guides</li>
                        <li>Bush Dinner Experiences</li>
                        <li>Naturalist-Led Game Walks</li>
                    </ul>
                </div>

                <div class="accommodation-card">
                    <div class="stars">⭐⭐⭐⭐</div>
                    <h3>🏕️ Tented Safari Camps</h3>
                    <p>Immersive camping experiences with modern comforts. Wake up to wildlife sounds in luxury safari tents with all amenities.</p>
                    <ul>
                        <li>Luxury Canvas Tents</li>
                        <li>Ensuite Bathrooms</li>
                        <li>Campfire Experiences</li>
                        <li>Naturalist-Led Walks</li>
                        <li>Authentic Safari Experience</li>
                    </ul>
                </div>

                <div class="accommodation-card">
                    <div class="stars">⭐⭐⭐</div>
                    <h3>Mid-Range Hotel Properties</h3>
                    <p>Quality accommodations with excellent service at reasonable prices. Great for budget-conscious travelers without compromising comfort.</p>
                    <ul>
                        <li>Comfortable Private Rooms</li>
                        <li>Restaurant & Bar</li>
                        <li>Business Centers</li>
                        <li>WiFi & Entertainment</li>
                        <li>Free Breakfast Options</li>
                    </ul>
                </div>

                <div class="accommodation-card">
                    <div class="stars">⭐⭐⭐⭐</div>
                    <h3>🏖️ Beachfront Resorts</h3>
                    <p>Stunning beach properties in Mombasa and Zanzibar. Water sports, diving, and tropical relaxation at their finest.</p>
                    <ul>
                        <li>Private Beach Access</li>
                        <li>Water Sports Facilities</li>
                        <li>Diving & Snorkeling</li>
                        <li>All-Inclusive Options</li>
                        <li>Beach Bar & Restaurants</li>
                    </ul>
                </div>

                <div class="accommodation-card">
                    <div class="stars">⭐⭐</div>
                    <h3>💰 Budget-Friendly Options</h3>
                    <p>Affordable, clean accommodations for budget travelers. No compromise on safety or basic amenities.</p>
                    <ul>
                        <li>Private & Dorm Rooms</li>
                        <li>Community Kitchens</li>
                        <li>Traveler Facilities</li>
                        <li>Social Lounges</li>
                        <li>Tour Desk Services</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Testimonials Section -->
        <section id="testimonials" class="content-section">
            <div class="section-header">
                <h2>💬 What Our Guests Say</h2>
                <p class="section-subtitle">Real experiences from real travelers who have explored with us</p>
            </div>
            
            <div class="testimonial-grid">
                <div class="testimonial-card">
                    <div class="testimonial-stars">⭐⭐⭐⭐⭐</div>
                    <p class="testimonial-text">"An absolutely unforgettable safari experience! Lenawei Safaris exceeded all our expectations. The guides were knowledgeable, the vehicles were comfortable, and the accommodations were spectacular. Highly recommended!"</p>
